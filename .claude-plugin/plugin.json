{
  "name": "oracledb",
  "version": "0.2.7",
  "description": "Connect, query, and interact with Oracle Databases and their data.",
  "author": {
    "name": "Google LLC",
    "email": "data-cloud-ai-integrations@google.com"
  },
  "homepage": "https://cloud.google.com/solutions/oracle",
  "repository": "https://github.com/gemini-cli-extensions/oracledb",
  "license": "Apache-2.0",
  "userConfig": {
    "oracle_connection_string": {
      "title": "Connection String",
      "description": "Oracle connection string (e.g., host:port/service_name or TNS alias)",
      "type": "string",
      "sensitive": false
    },
    "oracle_username": {
      "title": "Username",
      "description": "Oracle database username",
      "type": "string",
      "sensitive": false
    },
    "oracle_password": {
      "title": "Password",
      "description": "Oracle database password",
      "type": "string",
      "sensitive": false
    },
    "oracle_wallet": {
      "title": "Wallet Path",
      "description": "(Optional) Path to the Oracle Wallet directory",
      "type": "string",
      "sensitive": false
    },
    "oracle_use_oci": {
      "title": "Use OCI",
      "description": "(Optional) Set to true to use the OCI (thick client) driver (Default: false)",
      "type": "string",
      "sensitive": false
    }
  },
  "mcpServers": {
    "oracledb": {
      "command": "npx",
      "args": [
        "-y",
        "@toolbox-sdk/server@1.9.0",
        "--prebuilt",
        "oracledb",
        "--stdio"
      ],
      "env": {
        "ORACLE_CONNECTION_STRING": "${user_config.oracle_connection_string}",
        "ORACLE_USERNAME": "${user_config.oracle_username}",
        "ORACLE_PASSWORD": "${user_config.oracle_password}",
        "ORACLE_WALLET": "${user_config.oracle_wallet}",
        "ORACLE_USE_OCI": "${user_config.oracle_use_oci}"
      }
    }
  }
}
